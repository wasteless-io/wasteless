# Normalisation des fins de ligne : LF dans le depot, quel que soit l'OS.
* text=auto

# Les scripts executes par bash doivent rester en LF meme sur un checkout
# Windows : en CRLF ils cassent sous WSL/Git Bash ("bad interpreter",
# erreurs '\r' en fin de ligne).
*.sh text eol=lf
Makefile text eol=lf
Brewfile text eol=lf

# Lanceurs Windows natifs : cmd.exe attend du CRLF (en LF, les sauts et
# etiquettes de batch se comportent mal). Les .ps1 en CRLF aussi, la
# convention Windows (PowerShell accepte les deux).
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires : jamais de conversion.
*.png binary
*.jpg binary
*.ico binary
